{
  "name": "circuit-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-arduino": "node scripts/prepare-arduino.mjs",
    "predev": "node scripts/prepare-arduino.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-arduino.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
