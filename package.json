    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/jetbrains-mono": "5.1.1",
    "avr8js": "0.21.1",
    "codemirror": "6.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@horang-corp/avr-gcc-wasm": "0.2.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
